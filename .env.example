# ---------------------------------------------------------------------------
# Cinebroad — environment template. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# === Existing desktop-app keys =============================================
WATCHMODE_API_KEY=
TMDB_API_KEY=
STREAMING_API_KEY=
OMDB_API_KEY=
INTERNET_ARCHIVE_API_ACCESS_KEY=
INTERNET_ARCHIVE_API_SECRET_KEY=

# === TVMaze (media service) ===============================================
# Public API needs no key. Base URL defaults to https://api.tvmaze.com when empty.
TV_MAZ_API_URL=https://api.tvmaze.com
# Optional — only the commercial TVMaze plan needs a key (sent as X-API-Key).
TVMAZE_API_KEY=

# === Supabase (media service) =============================================
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key (server-side only — bypasses RLS). Legacy JWT or sb_secret_… key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed to APPLY migrations automatically (npm run db:migrate).
# Create one at https://supabase.com/dashboard/account/tokens  (sbp_…)
SUPABASE_ACCESS_TOKEN=
# Optional: override the project ref parsed from the URL host
SUPABASE_PROJECT_REF=

SERVER_PORT=4555
MEDIA_CACHE_TTL_MS=604800000
TVMAZE_TIMEOUT_MS=10000

# === Download resolver =====================================================
# Minimum healthy seeders. Default in code is 3.
STREAM_MIN_SEEDERS=3
STREAM_RESOLVER_TIMEOUT_MS=10000
# YTS JSON API (magnets + seeders, no HTML scrape).
YTS_API_URL=https://yts.mx/api/v2
# Embed order when no torrent has enough seeders. Names: vidsrc, 2embed, multiembed
FALLBACK_EMBED_PROVIDERS=vidsrc,2embed,multiembed
# OMDB_API_KEY (above) resolves an IMDb id from a title via https://www.omdbapi.com/
# TMDB_API_KEY (above) resolves imdb_id from a TMDB id via /external_ids.
# STREAMING_API_KEY (above) is the bearer token for STREAM_DDL_ENDPOINTS when
# STREAM_DDL_API_KEY is empty.
TORRENT_INDEXER_ENDPOINTS=
TORRENT_INDEXER_API_KEY=
STREAM_DDL_ENDPOINTS=
STREAM_DDL_API_KEY=

# === P2P Torrent Streaming ==================================================
# Set to "false" to disable magnet-based torrent streaming (returns 503).
# Set to "true" (or omit) to enable metadata resolution, peer discovery,
# piece downloading, and HTTP range playback of torrent media.
ENABLE_P2P_TORRENT=true

# ---------------------------------------------------------------------------
# NOTE The current .env in this repo uses these names instead — both are
# supported out of the box by server/config/env.js:
#   SUPABASE_URL_KEY                        (only honoured when it is a real URL)
#   SUPABASE_SERVICE_ROLE_SECRET_KEY        (legacy service_role JWT)
#   SUPABASE_SECRET_KEY                     (sb_secret_… key)
# When no project URL is present, it is derived from the "ref" claim of a
# Supabase JWT, so the service works without editing .env at all.
# ---------------------------------------------------------------------------